    {
      "id": "deurenberg",
      "name": "Deurenberg",
      "category": "body-fat",
      "equation": "BF% = 1.20·BMI + 0.23·age − 10.8·sex − 5.4 (BMI in kg/m², age in years)",
      "inputs": [
        "bmi",
        "age",
        "sex"
      ],
      "source": {
        "authors": "Deurenberg, Weststrate & Seidell",
        "year": 1991,
        "journal": "Br J Nutr 65(2):105–114",
        "doi": "https://doi.org/10.1079/BJN19910073"
      },
      "sample": {
        "n": 1229,
        "population": "Netherlands adults",
        "reference_method": "densitometry (underwater weighing)"
      },
      "error": {
        "note": "SEE 4.1 pp · R² 0.79",
        "value": 4.1,
        "unit": "pp"
      },
      "verification": "primary",
      "independent_derivation": true,
      "limitations": [
        "Overestimates in obesity (per the authors) and not validated in Asian populations. BMI-based, so it cannot tell muscle from fat."
      ],
      "canonical_page": "https://wimsta.com/deurenberg-formula/",
      "coefficients": {
        "bmi": 1.2,
        "age": 0.23,
        "sex": -10.8,
        "intercept": -5.4
      },
      "sex_coding": "male=1, female=0",
      "units": "metric"
    },
